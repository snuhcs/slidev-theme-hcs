{
  "name": "hcs-slides",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "slidev slides.md --port 3030",
    "dev:layouts": "slidev layouts.md --port 3031",
    "build": "slidev build slides.md",
    "export": "slidev export slides.md --output exports/slides.pdf",
    "export:steps": "slidev export slides.md --with-clicks --output exports/slides-steps.pdf",
    "export:pptx": "slidev export slides.md --format pptx --output exports/slides.pptx"
  },
  "devDependencies": {
    "@slidev/cli": "52.19.1",
    "@fontsource/noto-sans": "^5.2.0",
    "@fontsource/noto-sans-kr": "^5.2.0",
    "playwright-chromium": "^1.55.0"
  },
  "description": "HCS laboratory presentation template for Slidev"
}
