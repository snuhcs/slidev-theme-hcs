#!/usr/bin/env node
// Renders every slide of example.md and writes docs/gallery.md around them, so
// the catalogue people browse on GitHub is generated from the deck rather than
// maintained beside it. Also refreshes the README screenshot.
//
//   npm run gallery
import { spawn } from "node:child_process";
import { load } from "@slidev/parser/fs";
import { mkdir, readdir, readFile, rename, rm, writeFile } from "node:fs/promises";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const rootDir = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const entry = join(rootDir, "example.md");
const imageDir = join(rootDir, "docs", "gallery");
const galleryFile = join(rootDir, "docs", "gallery.md");
const screenshot = join(rootDir, "screenshot.png");
const slidevBin = join(rootDir, "node_modules", ".bin", "slidev");

// The four slides that stand in for the theme at the top of the README.
const coverSlides = [1, 7, 13, 16];

async function run(command, args) {
  await new Promise((resolvePromise, reject) => {
    const child = spawn(command, args, { cwd: rootDir, stdio: ["ignore", "pipe", "pipe"] });
    let output = "";

    child.stdout.on("data", (data) => (output += data));
    child.stderr.on("data", (data) => (output += data));
    child.on("error", reject);
    child.on("exit", (code) => {
      if (code === 0) {
        resolvePromise();
      } else {
        process.stderr.write(output);
        reject(new Error(`${command} exited with ${code}`));
      }
    });
  });
}

function slug(slide, index) {
  const layout = slide.frontmatter.layout ?? "default";

  return `${String(index + 1).padStart(2, "0")}-${layout}`;
}

const data = await load({ userRoot: rootDir, entry }, entry);

console.log(`rendering ${data.slides.length} slides ...`);
await rm(imageDir, { recursive: true, force: true });
await mkdir(imageDir, { recursive: true });
await run(slidevBin, ["export", entry, "--format", "png", "--output", `${imageDir}/`]);

// Slidev names the files by page number. Give them the layout in the name so a
// directory listing is readable on its own.
for (const [index, slide] of data.slides.entries()) {
  await rename(join(imageDir, `${index + 1}.png`), join(imageDir, `${slug(slide, index)}.png`));
}

const sections = data.slides
  .map((slide, index) => {
    const layout = slide.frontmatter.layout ?? "default";
    const title = (slide.title ?? "").replace(/`/g, "");
    const heading = title ? `${index + 1}. \`${layout}\` — ${title}` : `${index + 1}. \`${layout}\``;

    return `### ${heading}\n\n![${layout} layout](gallery/${slug(slide, index)}.png)`;
  })
  .join("\n\n");

await writeFile(
  galleryFile,
  `# Layout gallery

Every slide of [\`example.md\`](../example.md), rendered. Each heading names the
layout that produced the slide; open \`example.md\` at that slide to see the
markdown behind it.

Generated by \`npm run gallery\` — edit the deck, not this file.

${sections}
`,
);

// The README screenshot is four of these slides in a grid, drawn at twice the
// pixel density so the text stays sharp when GitHub scales it down.
const shots = await Promise.all(
  coverSlides.map(async (page) => {
    const slide = data.slides[page - 1];
    const file = join(imageDir, `${slug(slide, page - 1)}.png`);

    return `data:image/png;base64,${(await readFile(file)).toString("base64")}`;
  }),
);

const page = `<!doctype html><html><head><style>
  html, body { margin: 0; background: #e9e9ec }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 12px; width: 1600px; box-sizing: border-box }
  img { width: 100%; display: block; border: 1px solid #d5d5da }
</style></head><body><div class="grid">${shots.map((s) => `<img src="${s}">`).join("")}</div></body></html>`;

const pageFile = join(imageDir, "screenshot.html");
await writeFile(pageFile, page);

const { chromium } = await import("playwright-chromium");
const browser = await chromium.launch();
const tab = await browser.newPage({ viewport: { width: 1600, height: 1000 }, deviceScaleFactor: 2 });
await tab.goto(`file://${pageFile}`);
await (await tab.$(".grid")).screenshot({ path: screenshot });
await browser.close();
await rm(pageFile);

const written = (await readdir(imageDir)).length;
console.log(`docs/gallery/ ${written} images\ndocs/gallery.md\nscreenshot.png`);
